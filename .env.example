# Names only; values live in qone-infra/.env (never versioned). Everything the service reads.
ENROLLMENT_DATABASE_URL=postgresql://enrollment:password@enrollment-db:5432/enrollment
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
CURRENT_TERM=2026-B
# A record created on first access takes this program (the token carries no program).
DEFAULT_PROGRAM=Ingeniería de Software
PORT=8000
LOG_LEVEL=info
